+#ifndef INFINI_OPS_LINKED_TORCH_OPS_QUICK_GELU_H_
+#define INFINI_OPS_LINKED_TORCH_OPS_QUICK_GELU_H_
+
+#include "base/quick_gelu.h"
+#include "torch/tensor_.h"
+
+namespace infini::ops::linked::torch {
+
+template <typename Backend>
+class TorchQuickGelu : public ::infini::ops::QuickGelu {
+ public:
+  TorchQuickGelu(const Tensor input, Tensor out)
+      : ::infini::ops::QuickGelu{input, out},
+        input_shape_{input.shape()},
+        input_strides_{input.strides()},
+        out_shape_{out.shape()},
+        out_strides_{out.strides()},
+        input_type_{input.dtype()},
+        out_type_{out.dtype()},
+        device_index_{out.device().index()} {}
+
+  using ::infini::ops::QuickGelu::operator();
+
+  void operator()(const Tensor input, Tensor out) const override {
+    const typename Backend::StreamGuard stream_guard{
+        Backend::GetStreamFromExternal(stream_, device_index_)};
+    auto at_input = ToAtenTensor<Backend::kDeviceType>(
+        const_cast<void*>(input.data()), input_shape_, input_strides_,
+        input_type_, device_index_);
+    auto at_out = ToAtenTensor<Backend::kDeviceType>(
+        out.data(), out_shape_, out_strides_, out_type_, device_index_);
+
+    auto backend_input =
+        is_input_contiguous_ ? at_input : at_input.contiguous();
+    auto backend_out = is_out_contiguous_
+                           ? at_out
+                           : at::empty(at_out.sizes(), at_out.options());
+
+    Backend::Call(backend_out, backend_input);
+    if (!is_out_contiguous_) {
+      at_out.copy_(backend_out);
+    }
+  }
+
+ private:
+  Tensor::Shape input_shape_;
+  Tensor::Strides input_strides_;
+  Tensor::Shape out_shape_;
+  Tensor::Strides out_strides_;
+  DataType input_type_;
+  DataType out_type_;
+  bool is_input_contiguous_{false};
+  bool is_out_contiguous_{false};
+  int device_index_{0};
+};
+
+}  // namespace infini::ops::linked::torch
+
+#endif  // INFINI_OPS_LINKED_TORCH_OPS_QUICK_GELU_H_
diff --git a/src/native/cuda/metax/ops/causal_conv1d/kernel.h b/src/native/cuda/metax/ops/causal_conv1d/kernel.h
new file mode 100644
index 0000000000000000000000000000000000000000..7b0e069a660f6db61352f2c6974aa700f8658fce
--- /dev/null
+++ b/src/native/cuda/metax/ops/causal_conv1d/kernel.h
@@ -0,0 +1,196 @@
+#ifndef INFINI_OPS_METAX_CAUSAL_CONV1D_KERNEL_H_
+#define INFINI_OPS_METAX_CAUSAL_CONV1D_KERNEL_H_
+
+#include <climits>
+#include <stdexcept>
+
+#include "base/causal_conv1d.h"
+#include "native/cuda/metax/runtime_.h"
+// cuda_fp16.h / cuda_bf16.h come from the MACA cu-bridge,
+// where __nv_bfloat16 aliases __maca_bfloat16.
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+
+namespace infini::ops {
+namespace metax_causal_conv1d_detail {
+struct Layout {
+  ptrdiff_t strides[9][3]{};
+  size_t tokens, channels, pool;
+  bool cu_i64, initial_i64, final_i64;
+};
+__device__ inline int64_t index(const void* p, bool i64, int i, int fallback) {
+  return p ? (i64 ? static_cast<const int64_t*>(p)[i]
+                  : static_cast<int64_t>(static_cast<const int32_t*>(p)[i]))
+           : fallback;
+}
+template <typename T>
+__device__ inline float history(const T* state, const T* qkv, int64_t pos,
+                                int64_t begin, int batch, int channel,
+                                ptrdiff_t base, const Layout& p) {
+  if (pos < 3) return static_cast<float>(state[base + pos * p.strides[2][2]]);
+  const auto off = static_cast<ptrdiff_t>(batch) * p.strides[0][0] +
+                   static_cast<ptrdiff_t>(begin + pos - 3) * p.strides[0][1] +
+                   static_cast<ptrdiff_t>(channel) * p.strides[0][2];
+  return static_cast<float>(qkv[off]);
+}
+// Port of baseline InfiniCore-0.2.9 causal_conv1d_k4_kernel. One thread per
+// request/channel reads the entire sequence before committing its final state.
+template <typename T>
+__global__ void kernel(const T* qkv, const T* weight, T* state, const T* bias,
+                       const void* cu, const void* initial,
+                       const void* final_indices, T* out, T* final_state,
+                       Layout p) {
+  const int request = blockIdx.x, channel = blockIdx.y;
+  if (static_cast<size_t>(channel) >= p.channels || threadIdx.x != 0) return;
+  int64_t begin = 0, end = static_cast<int64_t>(p.tokens);
+  int batch = request;
+  if (cu) {
+    begin = index(cu, p.cu_i64, request, 0);
+    end = index(cu, p.cu_i64, request + 1, 0);
+    batch = 0;
+    // Preserve baseline device-value behavior: malformed range leaves the
+    // corresponding output/state untouched. This is not host validation.
+    if (begin < 0 || end < begin || end > static_cast<int64_t>(p.tokens))
+      return;
+  }
+  const int64_t length = end - begin;
+  const int64_t read = index(initial, p.initial_i64, request, request);
+  const int64_t write = index(final_indices, p.final_i64, request, request);
+  if (read < 0 || write < 0 || read >= static_cast<int64_t>(p.pool) ||
+      (final_indices && write >= static_cast<int64_t>(p.pool)))
+    return;
+  const auto base = static_cast<ptrdiff_t>(read) * p.strides[2][0] +
+                    static_cast<ptrdiff_t>(channel) * p.strides[2][1];
+  const auto wb = static_cast<ptrdiff_t>(channel) * p.strides[1][0];
+  for (int64_t t = 0; t < length; ++t) {
+    float acc = static_cast<float>(weight[wb]) *
+                    history(state, qkv, t, begin, batch, channel, base, p) +
+                static_cast<float>(weight[wb + p.strides[1][2]]) *
+                    history(state, qkv, t + 1, begin, batch, channel, base, p) +
+                static_cast<float>(weight[wb + 2 * p.strides[1][2]]) *
+                    history(state, qkv, t + 2, begin, batch, channel, base, p) +
+                static_cast<float>(weight[wb + 3 * p.strides[1][2]]) *
+                    history(state, qkv, t + 3, begin, batch, channel, base, p);
+    if (bias)
+      acc += static_cast<float>(
+          bias[static_cast<ptrdiff_t>(channel) * p.strides[3][0]]);
+    const auto off = static_cast<ptrdiff_t>(batch) * p.strides[7][0] +
+                     static_cast<ptrdiff_t>(begin + t) * p.strides[7][1] +
+                     static_cast<ptrdiff_t>(channel) * p.strides[7][2];
+    out[off] = static_cast<T>(acc);
+  }
+  T* target = final_indices ? state : final_state;
+  const int stride_index = final_indices ? 2 : 8;
+  const auto target_base =
+      static_cast<ptrdiff_t>(final_indices ? write : request) *
+          p.strides[stride_index][0] +
+      static_cast<ptrdiff_t>(channel) * p.strides[stride_index][1];
+  // Same ordered commit as baseline. Exact initial/final alias is valid for
+  // short sequences because copied history source positions lie ahead of
+  // writes.
+  target[target_base] = static_cast<T>(
+      history(state, qkv, length, begin, batch, channel, base, p));
+  target[target_base + p.strides[stride_index][2]] = static_cast<T>(
+      history(state, qkv, length + 1, begin, batch, channel, base, p));
+  target[target_base + 2 * p.strides[stride_index][2]] = static_cast<T>(
+      history(state, qkv, length + 2, begin, batch, channel, base, p));
+}
+}  // namespace metax_causal_conv1d_detail
+
+template <>
+class Operator<CausalConv1d, Device::Type::kMetax> : public CausalConv1d {
+ public:
+  using CausalConv1d::CausalConv1d;
+  using CausalConv1d::operator();
+
+  Operator(const Tensor qkv, const Tensor weight, Tensor conv_state,
+           const std::optional<Tensor> bias,
+           const std::optional<Tensor> cu_seqlens,
+           const std::optional<Tensor> initial_state_indices,
+           const std::optional<Tensor> final_state_indices, Tensor out,
+           std::optional<Tensor> final_conv_state)
+      : CausalConv1d(qkv, weight, conv_state, bias, cu_seqlens,
+                     initial_state_indices, final_state_indices, out,
+                     final_conv_state) {
+    if (weight.shape()[2] != 4 || conv_state.shape()[2] != 3)
+      throw std::invalid_argument(
+          "MetaX causal conv kernel requires K4 and state_len3");
+    if (tokens_ > static_cast<size_t>(std::numeric_limits<int64_t>::max() - 3))
+      throw std::overflow_error(
+          "MetaX causal conv history index exceeds int64");
+    if (requests_ >= static_cast<size_t>(INT_MAX) || channels_ > 65535)
+      throw std::invalid_argument(
+          "causal conv request/channel launch extent unsupported");
+    p_.tokens = tokens_;
+    p_.channels = channels_;
+    p_.pool = pool_;
+    for (size_t i = 0; i < metadata_.size(); ++i)
+      if (metadata_[i])
+        for (size_t j = 0; j < metadata_[i]->strides().size(); ++j)
+          p_.strides[i][j] = metadata_[i]->strides()[j];
+    p_.cu_i64 = metadata_[4] && metadata_[4]->dtype() == DataType::kInt64;
+    p_.initial_i64 = metadata_[5] && metadata_[5]->dtype() == DataType::kInt64;
+    p_.final_i64 = metadata_[6] && metadata_[6]->dtype() == DataType::kInt64;
+  }
+
+  void operator()(const Tensor qkv, const Tensor weight, Tensor conv_state,
+                  const std::optional<Tensor> bias,
+                  const std::optional<Tensor> cu_seqlens,
+                  const std::optional<Tensor> initial_state_indices,
+                  const std::optional<Tensor> final_state_indices, Tensor out,
+                  std::optional<Tensor> final_conv_state) const override {
+    const Views views{qkv,
+                      weight,
+                      conv_state,
+                      bias,
+                      cu_seqlens,
+                      initial_state_indices,
+                      final_state_indices,
+                      out,
+                      final_conv_state};
+    for (size_t i = 0; i < views.size(); ++i) {
+      const auto& t = views[i];
+      if (t.has_value() != metadata_[i].has_value() ||
+          (t && (!std::equal_to<Tensor>{}(*t, *metadata_[i]) ||
+                 (t->numel() && !t->data()))))
+        throw std::invalid_argument(
+            "causal conv metadata changed or nonempty storage is null");
+    }
+    if (!requests_ || !channels_) return;
+    switch (dtype_) {
+      case DataType::kFloat32:
+        launch<float>(views);
+        break;
+      case DataType::kFloat16:
+        launch<half>(views);
+        break;
+      case DataType::kBFloat16:
+        launch<__nv_bfloat16>(views);
+        break;
+      default:
+        throw std::invalid_argument("causal conv dtype unsupported");
+    }
+  }
+
+ private:
+  metax_causal_conv1d_detail::Layout p_{};
+  template <typename T>
+  void launch(const Views& v) const {
+    auto pointer = [&](size_t i) -> void* {
+      return v[i] ? const_cast<void*>(v[i]->data()) : nullptr;
+    };
+    const dim3 grid(static_cast<unsigned int>(requests_),
+                    static_cast<unsigned int>(channels_), 1);
+    const auto stream =
+        static_cast<typename Runtime<Device::Type::kMetax>::Stream>(
+            stream_ ? stream_ : nullptr);
+    metax_causal_conv1d_detail::kernel<T><<<grid, 1, 0, stream>>>(
+        static_cast<const T*>(pointer(0)), static_cast<const T*>(pointer(1)),
+        static_cast<T*>(pointer(2)), static_cast<const T*>(pointer(3)),
+        pointer(4), pointer(5), pointer(6), static_cast<T*>(pointer(7)),
+        static_cast<T*>(pointer(8)), p_);
+  }
+};
+}  // namespace infini::ops
+
+#endif
diff --git a/src/native/cuda/metax/ops/chunk_gated_delta_rule/chunk_gated_delta_rule_legacy_kernel.cuh b/src/native/cuda/metax/ops/chunk_gated_delta_rule/chunk_gated_delta_rule_legacy_kernel.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..4ec06e8d6154108652d95629332ec17b06b7ef2d
--- /dev/null
+++ b/src/native/cuda/metax/ops/chunk_gated_delta_rule/chunk_gated_delta_rule_legacy_kernel.cuh
@@ -0,0 +1,261 @@
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+// Ported from InfiniCore 1ab85ef1d3c2bce49edf1fc73a5b48becaf7552e:
+// src/infiniop/ops/chunk_gated_delta_rule/cuda/kernel.cuh.
+// Modified for InfiniOps: active helpers/state kernel and namespace adaptation.
+// Copyright 2025 InfiniTensor; MIT notice: LICENSES/InfiniCore-MIT.txt.
+#pragma once
+#include <cstdint>
+// Exact baseline helpers and active state-workspace kernel. The baseline
+// chunked-matrix branch is hard-disabled and is not copied as a second path.
+namespace infini::ops::chunk_native_detail {
+__device__ inline int64_t loadOptionalIndex(const void* indices, bool is_i64,
+                                            int idx, int fallback) {
+  if (indices == nullptr) {
+    return static_cast<int64_t>(fallback);
+  }
+  return is_i64
+             ? static_cast<const int64_t*>(indices)[idx]
+             : static_cast<int64_t>(static_cast<const int32_t*>(indices)[idx]);
+}
+
+template <typename T>
+__device__ inline float loadAsFloat(const T* ptr, ptrdiff_t offset) {
+  return static_cast<float>(ptr[offset]);
+}
+
+template <>
+__device__ inline float loadAsFloat<half>(const half* ptr, ptrdiff_t offset) {
+  return __half2float(ptr[offset]);
+}
+
+template <>
+__device__ inline float loadAsFloat<__nv_bfloat16>(const __nv_bfloat16* ptr,
+                                                   ptrdiff_t offset) {
+  return __bfloat162float(ptr[offset]);
+}
+
+#define CGDR_FOR(idx, n) \
+  for (int idx = threadIdx.x; idx < static_cast<int>(n); idx += blockDim.x)
+
+template <typename Tcompute, int NUM_THREADS>
+__device__ Tcompute blockReduceSum(Tcompute v) {
+  __shared__ Tcompute smem[NUM_THREADS];
+  smem[threadIdx.x] = v;
+  __syncthreads();
+
+  for (int s = NUM_THREADS / 2; s > 0; s >>= 1) {
+    if (threadIdx.x < s) {
+      smem[threadIdx.x] += smem[threadIdx.x + s];
+    }
+    __syncthreads();
+  }
+  return smem[0];
+}
+
+template <typename Tdata, typename Tgate, typename Tcompute, size_t Dk,
+          size_t Dv, size_t NUM_THREADS>
+__device__ void chunkGatedDeltaRuleRecurrentKernel(
+    Tcompute* state_workspace, Tdata* out, Tdata* initial_state,
+    Tdata* final_state, const Tdata* q, const Tdata* k, const Tdata* v,
+    const Tgate* g, const Tgate* beta, const void* cu_seqlens,
+    const void* initial_state_indices, const void* final_state_indices,
+    bool cu_seqlens_i64, bool initial_state_indices_i64,
+    bool final_state_indices_i64, bool use_qk_l2norm, bool has_cu_seqlens,
+    bool indexed_state_pool, size_t T, size_t pool_size, size_t Hk,
+    size_t value_heads_per_key_head, ptrdiff_t out_s0, ptrdiff_t out_s1,
+    ptrdiff_t out_s2, ptrdiff_t initial_s0, ptrdiff_t initial_s1,
+    ptrdiff_t initial_s2, ptrdiff_t initial_s3, ptrdiff_t final_s0,
+    ptrdiff_t final_s1, ptrdiff_t final_s2, ptrdiff_t final_s3, ptrdiff_t q_s0,
+    ptrdiff_t q_s1, ptrdiff_t q_s2, ptrdiff_t k_s0, ptrdiff_t k_s1,
+    ptrdiff_t k_s2, ptrdiff_t v_s0, ptrdiff_t v_s1, ptrdiff_t v_s2,
+    ptrdiff_t g_s0, ptrdiff_t g_s1, ptrdiff_t g_s2, ptrdiff_t beta_s0,
+    ptrdiff_t beta_s1, ptrdiff_t beta_s2) {
+  const int batch_idx = blockIdx.x;
+  const int value_head_idx = blockIdx.y;
+  const int key_head_idx =
+      value_head_idx / static_cast<int>(value_heads_per_key_head);
+
+  if (key_head_idx >= static_cast<int>(Hk)) {
+    return;
+  }
+
+  int64_t token_begin = 0;
+  int64_t token_end = static_cast<int64_t>(T);
+
+  if (has_cu_seqlens) {
+    token_begin = loadOptionalIndex(cu_seqlens, cu_seqlens_i64, batch_idx, 0);
+    token_end = loadOptionalIndex(cu_seqlens, cu_seqlens_i64, batch_idx + 1, 0);
+    if (token_begin < 0 || token_end < token_begin ||
+        token_end > static_cast<int64_t>(T)) {
+      return;
+    }
+  }
+
+  int64_t read_slot = batch_idx;
+  int64_t write_slot = batch_idx;
+
+  if (indexed_state_pool) {
+    read_slot = loadOptionalIndex(
+        initial_state_indices, initial_state_indices_i64, batch_idx, batch_idx);
+
+    write_slot =
+        final_state_indices == nullptr
+            ? static_cast<int64_t>(batch_idx)
+            : loadOptionalIndex(final_state_indices, final_state_indices_i64,
+                                batch_idx, batch_idx);
+
+    if (read_slot < 0 || read_slot >= static_cast<int64_t>(pool_size) ||
+        (final_state_indices != nullptr &&
+         (write_slot < 0 || write_slot >= static_cast<int64_t>(pool_size)))) {
+      return;
+    }
+  }
+
+  const ptrdiff_t initial_base =
+      indexed_state_pool
+          ? static_cast<ptrdiff_t>(read_slot) * initial_s0 +
+                static_cast<ptrdiff_t>(value_head_idx) * initial_s1
+          : static_cast<ptrdiff_t>(batch_idx) * initial_s0 +
+                static_cast<ptrdiff_t>(value_head_idx) * initial_s1;
+
+  Tdata* final_state_target = nullptr;
+  ptrdiff_t final_base = 0;
+
+  if (indexed_state_pool && final_state_indices != nullptr) {
+    final_state_target = initial_state;
+    final_base = static_cast<ptrdiff_t>(write_slot) * initial_s0 +
+                 static_cast<ptrdiff_t>(value_head_idx) * initial_s1;
+  } else {
+    final_state_target = final_state;
+    final_base = static_cast<ptrdiff_t>(batch_idx) * final_s0 +
+                 static_cast<ptrdiff_t>(value_head_idx) * final_s1;
+  }
+
+  const ptrdiff_t workspace_block =
+      (static_cast<ptrdiff_t>(batch_idx) * gridDim.y +
+       static_cast<ptrdiff_t>(value_head_idx)) *
+      static_cast<ptrdiff_t>(Dk * Dv);
+
+  Tcompute* state_local = state_workspace + workspace_block;
+  __shared__ Tcompute q_vec[Dk];
+  __shared__ Tcompute k_vec[Dk];
+  __shared__ Tcompute v_new[Dv];
+  __shared__ Tcompute scalar_buf[3];
+
+  const int token_batch = has_cu_seqlens ? 0 : batch_idx;
+  const Tcompute scale = rsqrtf(static_cast<Tcompute>(Dk));
+
+  CGDR_FOR(i, Dk * Dv) {
+    int dk = i / Dv;
+    int dv = i % Dv;
+
+    ptrdiff_t read_idx = initial_base +
+                         static_cast<ptrdiff_t>(dv) * initial_s2 +
+                         static_cast<ptrdiff_t>(dk) * initial_s3;
+
+    state_local[i] =
+        static_cast<Tcompute>(loadAsFloat(initial_state, read_idx));
+  }
+  __syncthreads();
+
+  for (int64_t token_idx = token_begin; token_idx < token_end; ++token_idx) {
+    ptrdiff_t q_base = static_cast<ptrdiff_t>(token_batch) * q_s0 +
+                       static_cast<ptrdiff_t>(token_idx) * q_s1 +
+                       static_cast<ptrdiff_t>(key_head_idx) * q_s2;
+    ptrdiff_t k_base = static_cast<ptrdiff_t>(token_batch) * k_s0 +
+                       static_cast<ptrdiff_t>(token_idx) * k_s1 +
+                       static_cast<ptrdiff_t>(key_head_idx) * k_s2;
+
+    Tcompute q_sum = 0;
+    Tcompute k_sum = 0;
+    for (int dk = threadIdx.x; dk < static_cast<int>(Dk); dk += blockDim.x) {
+      Tcompute q_raw = static_cast<Tcompute>(loadAsFloat(q, q_base + dk));
+      Tcompute k_raw = static_cast<Tcompute>(loadAsFloat(k, k_base + dk));
+      q_vec[dk] = q_raw;
+      k_vec[dk] = k_raw;
+      q_sum += q_raw * q_raw;
+      k_sum += k_raw * k_raw;
+    }
+
+    q_sum = blockReduceSum<Tcompute, NUM_THREADS>(q_sum);
+    k_sum = blockReduceSum<Tcompute, NUM_THREADS>(k_sum);
+
+    if (threadIdx.x == 0) {
+      ptrdiff_t gate_offset = static_cast<ptrdiff_t>(token_batch) * g_s0 +
+                              static_cast<ptrdiff_t>(token_idx) * g_s1 +
+                              static_cast<ptrdiff_t>(value_head_idx) * g_s2;
+      ptrdiff_t beta_offset = static_cast<ptrdiff_t>(token_batch) * beta_s0 +
+                              static_cast<ptrdiff_t>(token_idx) * beta_s1 +
+                              static_cast<ptrdiff_t>(value_head_idx) * beta_s2;
+
+      scalar_buf[0] = expf(static_cast<Tcompute>(loadAsFloat(g, gate_offset)));
+      scalar_buf[1] = static_cast<Tcompute>(loadAsFloat(beta, beta_offset));
+      scalar_buf[2] = use_qk_l2norm
+                          ? rsqrtf(q_sum + static_cast<Tcompute>(1e-6)) * scale
+                          : scale;
+    }
+    __syncthreads();
+
+    const Tcompute decay = scalar_buf[0];
+    const Tcompute beta_t = scalar_buf[1];
+    const Tcompute q_scale = scalar_buf[2];
+    const Tcompute k_scale = use_qk_l2norm
+                                 ? rsqrtf(k_sum + static_cast<Tcompute>(1e-6))
+                                 : static_cast<Tcompute>(1);
+
+    for (int dk = threadIdx.x; dk < static_cast<int>(Dk); dk += blockDim.x) {
+      q_vec[dk] *= q_scale;
+      k_vec[dk] *= k_scale;
+    }
+    __syncthreads();
+
+    for (int dv = threadIdx.x; dv < static_cast<int>(Dv); dv += blockDim.x) {
+      Tcompute projected = 0;
+      for (int dk = 0; dk < static_cast<int>(Dk); ++dk) {
+        projected += k_vec[dk] * state_local[dk * Dv + dv];
+      }
+
+      ptrdiff_t v_base = static_cast<ptrdiff_t>(token_batch) * v_s0 +
+                         static_cast<ptrdiff_t>(token_idx) * v_s1 +
+                         static_cast<ptrdiff_t>(value_head_idx) * v_s2;
+      Tcompute v_raw = static_cast<Tcompute>(loadAsFloat(v, v_base + dv));
+      v_new[dv] = beta_t * (v_raw - decay * projected);
+    }
+    __syncthreads();
+
+    CGDR_FOR(x, Dk * Dv) {
+      int dk = x / Dv;
+      int dv = x % Dv;
+      state_local[x] = decay * state_local[x] + k_vec[dk] * v_new[dv];
+    }
+    __syncthreads();
+
+    for (int dv = threadIdx.x; dv < static_cast<int>(Dv); dv += blockDim.x) {
+      Tcompute out_val = 0;
+      for (int dk = 0; dk < static_cast<int>(Dk); ++dk) {
+        out_val += q_vec[dk] * state_local[dk * Dv + dv];
+      }
+
+      ptrdiff_t out_base = static_cast<ptrdiff_t>(token_batch) * out_s0 +
+                           static_cast<ptrdiff_t>(token_idx) * out_s1 +
+                           static_cast<ptrdiff_t>(value_head_idx) * out_s2;
+      out[out_base + dv] = static_cast<Tdata>(out_val);
+    }
+    __syncthreads();
+  }
+
+  CGDR_FOR(i, Dk * Dv) {
+    int dk = i / Dv;
+    int dv = i % Dv;
+
+    const ptrdiff_t s2 = final_state_indices != nullptr ? initial_s2 : final_s2;
+    const ptrdiff_t s3 = final_state_indices != nullptr ? initial_s3 : final_s3;
+    ptrdiff_t write_idx = final_base + static_cast<ptrdiff_t>(dv) * s2 +
+                          static_cast<ptrdiff_t>(dk) * s3;
+
+    final_state_target[write_idx] = static_cast<Tdata>(state_local[i]);
+  }
+}
+#undef CGDR_FOR
+}  // namespace infini::ops::chunk_native_detail
diff --git a/src/native/cuda/metax/ops/chunk_gated_delta_rule/kernel.h b/src/native/cuda/metax/ops/chunk_gated_delta_rule/kernel.h
new file mode 100644
index 0000000000000000000000000000000000000000..bb1465bf5646f2498f77d873a0d33e8ba6c06276
--- /dev/null
+++ b/src/native/cuda/metax/ops/chunk_gated_delta_rule/kernel.h
@@ -0,0 +1,171 @@
+#ifndef INFINI_OPS_METAX_CHUNK_GATED_DELTA_RULE_KERNEL_H_
+#define INFINI_OPS_METAX_CHUNK_GATED_DELTA_RULE_KERNEL_H_
+
+#include <climits>
+#include <stdexcept>
+
+#include "base/chunk_gated_delta_rule.h"
+#include "chunk_gated_delta_rule_legacy_kernel.cuh"
+#include "native/cuda/metax/runtime_.h"
+// cuda_fp16.h / cuda_bf16.h come from the MACA cu-bridge,
+// where __nv_bfloat16 aliases __maca_bfloat16.
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+
+namespace infini::ops {
+namespace chunk_native_detail {
+struct Layout {
+  // Rows follow Views: q, k, v, g, beta, initial_state, cu_seqlens,
+  // initial_state_indices, final_state_indices, out, final_state (0..10).
+  // Each row stores that tensor axis strides, up to the four state axes.
+  ptrdiff_t s[11][4]{};
+  bool cu_i64, initial_i64, final_i64, norm, indexed, packed;
+  size_t T, pool, Hk, ratio;
+};
+template <typename Data, typename Gate, size_t D>
+__global__ void kernel(float* workspace, const Data* q, const Data* k,
+                       const Data* v, const Gate* g, const Gate* beta,
+                       Data* state, const void* cu, const void* initial_indices,
+                       const void* final_indices, Data* out, Data* final_state,
+                       Layout p) {
+  // q/k/v/out have a contiguous last axis, so only their first three strides
+  // are passed. Initial/final state uses all axes of [pool,Hv,Dv,Dk].
+  chunkGatedDeltaRuleRecurrentKernel<Data, Gate, float, D, D, D>(
+      workspace, out, state, final_state, q, k, v, g, beta, cu, initial_indices,
+      final_indices, p.cu_i64, p.initial_i64, p.final_i64, p.norm, p.packed,
+      p.indexed, p.T, p.pool, p.Hk, p.ratio, p.s[9][0], p.s[9][1], p.s[9][2],
+      p.s[5][0], p.s[5][1], p.s[5][2], p.s[5][3], p.s[10][0], p.s[10][1],
+      p.s[10][2], p.s[10][3], p.s[0][0], p.s[0][1], p.s[0][2], p.s[1][0],
+      p.s[1][1], p.s[1][2], p.s[2][0], p.s[2][1], p.s[2][2], p.s[3][0],
+      p.s[3][1], p.s[3][2], p.s[4][0], p.s[4][1], p.s[4][2]);
+}
+}  // namespace chunk_native_detail
+
+template <>
+class Operator<ChunkGatedDeltaRule, Device::Type::kMetax>
+    : public ChunkGatedDeltaRule {
+ public:
+  Operator(const Tensor q, const Tensor k, const Tensor v, const Tensor g,
+           const Tensor beta, Tensor initial_state,
+           const std::optional<Tensor> cu_seqlens,
+           const std::optional<Tensor> initial_state_indices,
+           const std::optional<Tensor> final_state_indices, Tensor out,
+           std::optional<Tensor> final_state, bool use_qk_l2norm,
+           size_t chunk_size)
+      : ChunkGatedDeltaRule(q, k, v, g, beta, initial_state, cu_seqlens,
+                            initial_state_indices, final_state_indices, out,
+                            final_state, use_qk_l2norm, chunk_size) {
+    if (v.shape()[3] != D_ || (D_ != 64 && D_ != 128))
+      throw std::invalid_argument(
+          "MetaX chunk delta kernels require Dk=Dv64/128");
+    if (B_ >= static_cast<size_t>(INT_MAX) || Hv_ > 65535 ||
+        Hk_ > static_cast<size_t>(INT_MAX))
+      throw std::invalid_argument("chunk delta launch extent unsupported");
+    const auto maximum = std::numeric_limits<size_t>::max();
+    const size_t per_head = D_ * D_ * sizeof(float);
+    if (B_ > maximum / Hv_ || B_ * Hv_ > maximum / per_head)
+      throw std::overflow_error("chunk delta workspace size overflows");
+    bytes_ = B_ * Hv_ * per_head;
+    if (bytes_ / sizeof(float) >
+        static_cast<size_t>(std::numeric_limits<ptrdiff_t>::max()))
+      throw std::overflow_error(
+          "chunk delta workspace element offset exceeds ptrdiff");
+    p_.pool = pool_;
+    p_.Hk = Hk_;
+    p_.ratio = Hv_ / Hk_;
+    p_.norm = norm_;
+    p_.T = T_;
+    p_.packed = metadata_[6].has_value();
+    p_.indexed = metadata_[7].has_value() || metadata_[8].has_value();
+    p_.cu_i64 = metadata_[6] && metadata_[6]->dtype() == DataType::kInt64;
+    p_.initial_i64 = metadata_[7] && metadata_[7]->dtype() == DataType::kInt64;
+    p_.final_i64 = metadata_[8] && metadata_[8]->dtype() == DataType::kInt64;
+    for (size_t i = 0; i < metadata_.size(); ++i)
+      if (metadata_[i])
+        for (size_t j = 0; j < metadata_[i]->strides().size(); ++j)
+          p_.s[i][j] = metadata_[i]->strides()[j];
+  }
+  size_t workspace_size_in_bytes() const override { return bytes_; }
+  void operator()(const Tensor q, const Tensor k, const Tensor v,
+                  const Tensor g, const Tensor beta, Tensor initial_state,
+                  const std::optional<Tensor> cu_seqlens,
+                  const std::optional<Tensor> initial_state_indices,
+                  const std::optional<Tensor> final_state_indices, Tensor out,
+                  std::optional<Tensor> final_state, bool use_qk_l2norm,
+                  size_t chunk_size) const override {
+    const Views views{q,
+                      k,
+                      v,
+                      g,
+                      beta,
+                      initial_state,
+                      cu_seqlens,
+                      initial_state_indices,
+                      final_state_indices,
+                      out,
+                      final_state};
+    CheckInvocation(views, use_qk_l2norm, chunk_size);
+    if (!B_) return;
+    if (!workspace_ || workspace_size_in_bytes_ < bytes_)
+      throw std::invalid_argument("chunk delta workspace missing or too small");
+    switch (data_type_) {
+      case DataType::kFloat16:
+        gate<half>(views);
+        break;
+      case DataType::kBFloat16:
+        gate<__nv_bfloat16>(views);
+        break;
+      case DataType::kFloat32:
+        gate<float>(views);
+        break;
+      default:
+        throw std::invalid_argument("chunk delta data dtype unsupported");
+    }
+  }
+
+ private:
+  size_t bytes_{0};
+  chunk_native_detail::Layout p_{};
+  template <typename Data>
+  void gate(const Views& v) const {
+    switch (gate_type_) {
+      case DataType::kFloat16:
+        dimension<Data, half>(v);
+        break;
+      case DataType::kBFloat16:
+        dimension<Data, __nv_bfloat16>(v);
+        break;
+      case DataType::kFloat32:
+        dimension<Data, float>(v);
+        break;
+      default:
+        throw std::invalid_argument("chunk delta gate dtype unsupported");
+    }
+  }
+  template <typename Data, typename Gate>
+  void dimension(const Views& v) const {
+    if (D_ == 64)
+      launch<Data, Gate, 64>(v);
+    else
+      launch<Data, Gate, 128>(v);
+  }
+  template <typename Data, typename Gate, size_t D>
+  void launch(const Views& v) const {
+    auto ptr = [&](size_t i) -> void* {
+      return v[i] ? const_cast<void*>(v[i]->data()) : nullptr;
+    };
+    dim3 grid(static_cast<unsigned int>(B_), static_cast<unsigned int>(Hv_), 1);
+    const auto stream =
+        static_cast<typename Runtime<Device::Type::kMetax>::Stream>(
+            stream_ ? stream_ : nullptr);
+    chunk_native_detail::kernel<Data, Gate, D><<<grid, D, 0, stream>>>(
+        static_cast<float*>(workspace_), static_cast<const Data*>(ptr(0)),
+        static_cast<const Data*>(ptr(1)), static_cast<const Data*>(ptr(2)),
+        static_cast<const Gate*>(ptr(3)), static_cast<const Gate*>(ptr(4)),
+        static_cast<Data*>(ptr(5)), ptr(6), ptr(7), ptr(8),
+        static_cast<Data*>(ptr(9)), static_cast<Data*>(ptr(10)), p_);
+  }
+};
+}  // namespace infini::ops
+
+#endif
